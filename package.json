{
  "name": "upload-r2",
  "version": "1.0.0",
  "description": "Upload and download very large files to Cloudflare R2 with browser-side chunking",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "cors": "node scripts/apply-cors.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node --test \"test/e2e/*.e2e.js\""
  },
  "repository": {
