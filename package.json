    "url": "https://github.com/baolongt/upload-r2/issues"
  },
  "homepage": "https://github.com/baolongt/upload-r2#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
