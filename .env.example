# Cloudflare account that owns the bucket (dashboard → R2 → Overview)
R2_ACCOUNT_ID=your_account_id
# R2 API token with Object Read & Write on the bucket
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=your-bucket-name

# Password to enter the app. Leave empty and the app is open to anyone who can reach it.
APP_PASSWORD=

# Optional overrides
# SESSION_SECRET=            # defaults to a key derived from APP_PASSWORD
# SESSION_TTL_HOURS=168      # how long a sign-in lasts (default 7 days)
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_KEY_PREFIX=uploads/
# PORT=3000
# PRESIGN_EXPIRES=3600
# MAX_FILE_SIZE=5497558138880
# Origins allowed to talk to the bucket from the browser (comma separated), used by `npm run cors`
CORS_ORIGIN=http://localhost:3000

# Set to true for MinIO or any S3 mock that needs bucket-in-path addressing
# R2_FORCE_PATH_STYLE=false
